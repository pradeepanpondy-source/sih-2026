    "@types/nodemailer": "^7.0.9",
    "@vitejs/plugin-react": "^4.3.1",
    "canvas-confetti": "^1.9.4",
    "chokidar": "^4.0.3",
    "framer-motion": "^12.23.22",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.344.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2",
    "vite": "^7.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
