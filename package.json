{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n API,VITE -c cyan,yellow \"node server.mjs\" \"vite\"",
    "dev:api": "node server.mjs",
    "dev:full": "concurrently --kill-others-on-fail -n API,VITE -c cyan,yellow \"node server.mjs\" \"vite\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "git-auto": "node scripts/git-auto.mjs",
    "git-auto:start": "npm run git-auto",
    "git-auto:install": "npm install chokidar",
    "git:push": "git add . && git commit -m 'Manual commit' && git push origin main",
    "git:status": "git status"
  },
  "dependencies": {
