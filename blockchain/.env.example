# Blockchain environment variables
# Copy this to .env and fill in your values

# Your wallet private key (MetaMask → Account Details → Export Private Key)
# NEVER commit this file. It's in .gitignore.
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_here

# Polygon Amoy Testnet RPC URL
# Free options:
# - https://rpc-amoy.polygon.technology  (public)
# - Get free Alchemy/Infura key at https://alchemy.com or https://infura.io
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deployed contract address (filled in after running deploy script)
HONEYCHAIN_CONTRACT_ADDRESS=

# Polyscan API key (optional, for contract verification)
POLYGONSCAN_API_KEY=

# Get free Amoy testnet MATIC from:
# https://faucet.polygon.technology/
